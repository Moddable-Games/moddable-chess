{
  "name": "@moddable/chess-engine",
  "version": "0.9.20",
  "type": "module",
  "description": "Moddable Chess Engine — 70 variants, zero dependencies, pure JavaScript",
  "main": "js/chess-engine.js",
  "bin": {
    "moddable-chess-mcp": "./mcp/server.js"
  },
  "exports": {
    ".": "./js/chess-engine.js",
    "./moves": "./js/chess-moves.js",
    "./play": "./js/chess-play.js",
    "./ai": "./js/chess-ai.js",
    "./variants": "./js/chess-variants.js",
    "./units": "./js/chess-units.js",
    "./svg": "./js/chess-svg.js",
    "./mcp": "./mcp/tools.js"
  },
  "scripts": {
    "test": "node --experimental-vm-modules tests/smoke-all-variants.js",
    "test:variant": "node --experimental-vm-modules tests/variant-test.js",
    "test:visual": "node --experimental-vm-modules tests/visual-all-variants.js",
    "puzzles:download": "node --experimental-vm-modules scripts/download-lichess-puzzles.js",
    "puzzles:generate": "node --experimental-vm-modules scripts/generate-variant-puzzles.js",
    "puzzles:export": "node --experimental-vm-modules scripts/export-puzzles.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@resvg/resvg-js": "^2.6.2"
  }
}
